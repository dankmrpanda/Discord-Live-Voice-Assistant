{
  "name": "discord-live-vc-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discord live voice assistant using discord.js and Gemini Live API",
  "main": "dist/src-node/main.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src-node/main.ts",
    "start": "node dist/src-node/main.js",
    "bot": "node scripts/run-local.mjs",
    "bot:dev": "node scripts/run-local.mjs --dev",
    "register-commands": "tsx scripts/register-commands.ts",
    "healthcheck": "tsx scripts/healthcheck.ts"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@google/genai": "^1.30.0",
    "chokidar": "^4.0.3",
    "discord.js": "^14.20.0",
    "dotenv": "^17.2.3",
    "pino": "^10.1.0",
    "prism-media": "^1.3.5",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
